# Normalise to LF in the repository. Without this, a Windows checkout commits
# CRLF into shell scripts and they fail on a Linux host with "bad interpreter".
* text=auto eol=lf

# Windows-native files keep CRLF in the working copy.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touched.
*.woff2 binary
*.ttf   binary
*.png   binary
*.jpg   binary
*.ico   binary
