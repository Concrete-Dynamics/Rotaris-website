# Portainer stack environment for the Rotaris website.
#
# Portainer reads this file when the stack is deployed from this repository
# ("Load variables from .env file"). Nothing here is secret — the Portainer
# webhook URL lives in GitHub repository secrets, never in this file.
#
# Every variable also has a default in docker-compose.yml, so this file
# overrides rather than being a prerequisite.
#
# The Traefik values match the instance already serving another stack.
# TRAEFIK_RULE is the one PLACEHOLDER left: point it at the real hostname
# before the first production deploy, and update SITE_URL in the deploy
# workflow at the same time so canonical URLs and the sitemap agree.

# ── Stack ─────────────────────────────────────────────────────────────────────
STACK_NAME=rotaris-website

# ── Image ─────────────────────────────────────────────────────────────────────
# Published by .github/workflows/deploy.yml on every push to main.
# Swap IMAGE_TAG for a sha-<short-sha> tag to roll back.
IMAGE_REPOSITORY=ghcr.io/concrete-dynamics/rotaris-website
IMAGE_TAG=main

# ── Traefik ───────────────────────────────────────────────────────────────────
TRAEFIK_ENABLE=true

# External Docker network Traefik watches. Must already exist on the host.
TRAEFIK_NETWORK=traefik_net

# Router/service/middleware name prefix. Unique across the Traefik instance.
TRAEFIK_ROUTER=rotaris-website

# PLACEHOLDER — the host rule this stack answers on. Add a www variant the same
# way another stack does, for example:
#   TRAEFIK_RULE=Host(`rotaris.dev`) || Host(`www.rotaris.dev`)
TRAEFIK_RULE=Host(`rotaris.example.com`)

# HTTPS entrypoint as named in the Traefik static configuration. Traefik already
# redirects plain HTTP, so the stack defines no HTTP router of its own.
TRAEFIK_ENTRYPOINT=https

# ACME resolver as named in the Traefik static configuration.
TRAEFIK_CERTRESOLVER=simpleresolver

# Container port Traefik forwards to — matches EXPOSE in the Dockerfile.
TRAEFIK_SERVICE_PORT=8080

# ── HTTP basic auth ───────────────────────────────────────────────────────────
# A gate for the whole site, handled by Traefik before the request reaches the
# container. Useful while the domain, the legal pages and the release artifacts
# are not finished.
#
# Must be exactly `true` or `false` — the value becomes part of a Traefik
# middleware name, so `1`, `yes` or `True` will break the router.
BASIC_AUTH=false

# Shown in the browser's credential prompt.
BASIC_AUTH_REALM=Rotaris

# BASIC_AUTH_USERS is deliberately NOT set here.
#
# An empty value is not "no auth" — Traefik reads it as "no user may pass" and
# answers 401 to every request, which in a browser is an endless credential
# prompt that looks exactly like a wrong password. Leaving the key out entirely
# means it cannot overwrite a value set in Portainer's UI.
#
# Set it in Portainer → your stack → Environment variables. htpasswd format,
# comma-separated for several users. Traefik needs the password hashed
# (bcrypt, MD5/apr1 or SHA1); plain text does not work.
#
# Generate it with the helper, which prints the value ready to paste:
#   ./scripts/basic-auth.sh admin 'your-password'      (bash)
#   ./scripts/basic-auth.ps1 admin 'your-password'     (PowerShell)
#
# If you ever do put it in this file, double every `$` (`$$`) or Compose will
# truncate the hash at the first one and nobody will be able to log in.
# BASIC_AUTH_USERS=
