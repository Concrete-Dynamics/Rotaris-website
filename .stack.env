# Portainer stack environment for the Rotaris website.
#
# Portainer reads this file when the stack is deployed from this repository
# ("Load variables from .env file"). Nothing here is secret — the Portainer
# webhook URL and any registry credentials live in GitHub repository secrets
# and in Portainer itself, never in this file.
#
# The Traefik values are PLACEHOLDERS. Replace TRAEFIK_HOST, and confirm the
# entrypoint and certresolver names match the Traefik instance, before the
# first production deploy.

# ── Stack ─────────────────────────────────────────────────────────────────────
STACK_NAME=rotaris-website

# ── Image ─────────────────────────────────────────────────────────────────────
# Published by .github/workflows/deploy.yml on every push to main.
IMAGE_REPOSITORY=ghcr.io/concrete-dynamics/rotaris-website
IMAGE_TAG=main

# ── Traefik ───────────────────────────────────────────────────────────────────
TRAEFIK_ENABLE=true

# The external Docker network Traefik watches. Must already exist on the host.
TRAEFIK_NETWORK=traefik-proxy

# Router/service/middleware name prefix. Must be unique across the Traefik instance.
TRAEFIK_ROUTER=rotaris-website

# PLACEHOLDER — the public hostname this stack answers on.
TRAEFIK_HOST=rotaris.example.com

# Entrypoint names as configured in the Traefik static configuration.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ENTRYPOINT_HTTP=web

# ACME resolver name as configured in the Traefik static configuration.
TRAEFIK_CERTRESOLVER=letsencrypt

# Container port Traefik forwards to — matches EXPOSE in the Dockerfile.
TRAEFIK_SERVICE_PORT=8080

# HSTS max-age in seconds (63072000 = 2 years). Set to 0 to disable while the
# hostname is still a placeholder.
TRAEFIK_HSTS_SECONDS=0
